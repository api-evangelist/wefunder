          "name": "Get current user profile",
          "request": {
            "name": "Get current user profile",
            "description": {
              "content": "Retrieves the profile information for the currently authenticated user. This endpoint returns\nbasic user details including name, email, and account status.\n\nUse this endpoint to:\n- Display user information in your application\n- Verify the identity of the authenticated user\n- Check user account status and permissions\n\nThe response includes the user's unique ID which can be used to reference the user in other API calls.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "users",
                "me"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": " (This can only be one of api,staging)",
                  "type": "any",
                  "value": "{{environment}}",
                  "key": "environment"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:public read:profile read:investments read:campaigns read:attribution:aggregate read:attribution:anonymized read:attribution:full admin:attribution read:syndicates write:syndicates read:spvs write:spvs read:webhooks write:webhooks"
                },
