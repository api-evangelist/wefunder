                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns this member's investments in syndicate deals. Scoped to the syndicate's\nselected deals (one per company, matching directory semantics).\n\nAll monetary values are strings representing cents to avoid floating-point precision issues.\n"
        }
