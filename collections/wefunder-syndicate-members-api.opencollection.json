        },
        {
          "info": {
            "name": "List member investments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{environment}.wefunder.com/api/v2/syndicates/:syndicate_id/members/:member_id/investments",
            "params": [
              {
                "name": "syndicate_id",
                "value": "42",
                "type": "path",
                "description": "The syndicate ID"
              },
              {
                "name": "member_id",
                "value": "cr_123",
                "type": "path",
