                "value": "cr_123",
                "type": "path",
                "description": "The member ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://wefunder.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Approve a pending applicant. Only applicants can be approved via API; invitees must accept their invite link."
        },
        {
          "info": {
            "name": "Exile member",
            "type": "http"
