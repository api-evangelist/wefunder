              "accessTokenUrl": "https://wefunder.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Demote a member from full_access (admin) to operator permission."
        },
