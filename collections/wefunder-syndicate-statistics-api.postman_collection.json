          "id": "79964412-c223-4acb-9aef-82e7d7abbbd1",
          "name": "Get syndicate statistics",
          "request": {
            "name": "Get syndicate statistics",
            "description": {
              "content": "Returns aggregate metrics for a syndicate including member counts, deal counts,\ntotal raised, and recent activity.\n\n`total_raised` and `total_investors` are computed from directory-selected deals\n(one per company). `total_deals` and `live_deals` use all linked deals.\n\nAll monetary values are strings representing cents to avoid floating-point precision issues.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "syndicates",
                ":syndicate_id",
                "statistics"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "syndicate_id",
                  "description": "(Required) The syndicate ID"
                },
                {
                  "description": " (This can only be one of api,staging)",
                  "type": "any",
                  "value": "{{environment}}",
                  "key": "environment"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:public read:profile read:investments read:campaigns read:attribution:aggregate read:attribution:anonymized read:attribution:full admin:attribution read:syndicates write:syndicates read:spvs write:spvs read:webhooks write:webhooks"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://wefunder.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://wefunder.com/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
