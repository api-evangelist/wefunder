          "id": "7e3dcfea-b60f-4142-8db7-301e368698dc",
          "name": "List attributed investments",
          "request": {
            "name": "List attributed investments",
            "description": {
              "content": "Returns a list of attributed investments. The detail level depends on your access:\n\n**Tier 1 (Marketing Partners)** - Anonymized data:\n- Investor identity represented by opaque tokens (not real IDs)\n- Tokens are campaign-scoped (different token per campaign for same investor)\n- Investment amounts shown as tiers (small/medium/large), not exact values\n- No PII (email, name, address) is returned\n\n**Tier 2 (Founders/Employees)** - Full data with `detail_level=full`:\n- Real investment IDs (linkable to Wefunder admin)\n- Investor name, email, and username\n- Exact dollar amounts\n\n**Access**: Requires Tier 1+ access approval from Wefunder admin.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "campaigns",
                ":campaign_id",
                "attribution",
                "investments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<integer>",
                  "description": "Cursor-based pagination token. Use the `next_cursor` value from the previous response's\n`meta` object to retrieve the next page of results. Omit this parameter to retrieve the\nfirst page.\n"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Filter results to attributions on or after this date. Format: YYYY-MM-DD.\nDefaults to 90 days ago if not specified.\n"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "Filter results to attributions on or before this date. Format: YYYY-MM-DD.\nDefaults to today if not specified.\n"
                },
                {
                  "disabled": false,
                  "key": "utm_source",
                  "value": "<string>",
                  "description": "Filter by UTM source (e.g., \"GoogleAds\", \"facebook\", \"Klaviyo\")"
                },
                {
                  "disabled": false,
                  "key": "utm_campaign",
                  "value": "<string>",
                  "description": "Filter by UTM campaign name"
                },
                {
                  "disabled": false,
                  "key": "detail_level",
                  "value": "anonymized",
                  "description": "Level of detail to return:\n- `anonymized` (default): Opaque tokens, amount tiers\n- `full`: Real IDs, exact amounts, investor PII (founders only)\n\nMarketing partners always receive anonymized data regardless of this parameter.\n"
                }
