        {
          "id": "6fa06138-3032-4a07-b75f-95de73230869",
          "name": "Get aggregate attribution statistics",
          "request": {
            "name": "Get aggregate attribution statistics",
            "description": {
              "content": "Returns aggregate attribution statistics for a campaign. This is a **Tier 0** endpoint\navailable to all OAuth applications with the `read:attribution:aggregate` scope.\n\nUse this endpoint to:\n- Track overall marketing campaign performance\n- Measure conversion rates by UTM source/campaign\n- Monitor investment quality metrics\n- Build performance dashboards\n\nThe response includes totals and breakdowns by UTM parameters. All counts exclude\ndisputed attributions.\n\n**Privacy**: This endpoint returns aggregate data only. No individual investor\ninformation is exposed.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "campaigns",
                ":campaign_id",
                "attribution",
                "stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "Filter results to attributions on or after this date. Format: YYYY-MM-DD.\nDefaults to 90 days ago if not specified.\n"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "Filter results to attributions on or before this date. Format: YYYY-MM-DD.\nDefaults to today if not specified.\n"
                },
                {
                  "disabled": false,
                  "key": "utm_source",
                  "value": "<string>",
                  "description": "Filter by UTM source (e.g., \"GoogleAds\", \"facebook\", \"Klaviyo\")"
                },
                {
                  "disabled": false,
                  "key": "utm_campaign",
                  "value": "<string>",
                  "description": "Filter by UTM campaign name"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "campaign_id",
                  "description": "(Required) The fundraise/campaign ID"
                },
                {
                  "description": " (This can only be one of api,staging)",
                  "type": "any",
                  "value": "{{environment}}",
                  "key": "environment"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:public read:profile read:investments read:campaigns read:attribution:aggregate read:attribution:anonymized read:attribution:full admin:attribution read:syndicates write:syndicates read:spvs write:spvs read:webhooks write:webhooks"
