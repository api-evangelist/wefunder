          "name": "List user investments",
          "request": {
            "name": "List user investments",
            "description": {
              "content": "Retrieves a paginated list of all investments made by the authenticated user. Each investment\nincludes details about the amount invested, the company, investment date, and current status.\n\nUse this endpoint to:\n- Display a user's investment portfolio\n- Track investment history and performance\n- Build custom reporting and analytics\n\nThe list is ordered by investment date (newest first) and supports cursor-based pagination\nfor efficient iteration through large portfolios. Each investment object includes the\ncampaign details and current valuation information.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "investments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<integer>",
                  "description": "Cursor-based pagination token. Use the `next_cursor` value from the previous response's\n`meta` object to retrieve the next page of results. Omit this parameter to retrieve the\nfirst page.\n"
                }
              ],
              "variable": [
                {
                  "description": " (This can only be one of api,staging)",
                  "type": "any",
                  "value": "{{environment}}",
                  "key": "environment"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:public read:profile read:investments read:campaigns read:attribution:aggregate read:attribution:anonymized read:attribution:full admin:attribution read:syndicates write:syndicates read:spvs write:spvs read:webhooks write:webhooks"
                },
