                  "value": "https://wefunder.com/oauth/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://wefunder.com/oauth/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
