          "name": "List founder campaigns",
          "request": {
            "name": "List founder campaigns",
            "description": {
              "content": "Retrieves all fundraising campaigns for companies where the authenticated user is a founder.\nThis endpoint returns comprehensive campaign data including funding progress, investor counts,\nand campaign status.\n\nUse this endpoint to:\n- Build custom founder dashboards\n- Monitor fundraising progress across multiple campaigns\n- Generate reports on campaign performance\n- Integrate campaign data into your own tools\n\nOnly founders with the appropriate permissions can access this endpoint. The response includes\nboth active and closed campaigns, with detailed metrics for each.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "campaigns"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<integer>",
                  "description": "Cursor-based pagination token. Use the `next_cursor` value from the previous response's\n`meta` object to retrieve the next page of results. Omit this parameter to retrieve the\nfirst page.\n"
                }
              ],
              "variable": [
                {
                  "description": " (This can only be one of api,staging)",
                  "type": "any",
                  "value": "{{environment}}",
                  "key": "environment"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "read:public read:profile read:investments read:campaigns read:attribution:aggregate read:attribution:anonymized read:attribution:full admin:attribution read:syndicates write:syndicates read:spvs write:spvs read:webhooks write:webhooks"
